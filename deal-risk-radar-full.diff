+import { NextRequest } from "next/server";
+import { handleError, ok } from "@/lib/api";
+import { buildCrmSnapshot } from "@/lib/ai/context";
+import { buildDealRiskRadar } from "@/lib/ai/deal-risk";
+import { requireApiSession } from "@/lib/auth";
+import { connectDB } from "@/lib/db";
+
+export async function GET(request: NextRequest) {
+  try {
+    await requireApiSession(request);
+    await connectDB();
+
+    const leadId = request.nextUrl.searchParams.get("leadId") ?? undefined;
+    const snapshot = await buildCrmSnapshot();
+    return ok(buildDealRiskRadar(snapshot, leadId));
+  } catch (error) {
+    return handleError(error);
+  }
+}
