+++ b/lib/ai/deal-risk.ts
@@ -0,0 +1,157 @@
+import { HIGH_VALUE_THRESHOLD, recommendedActionFor, type CrmSnapshot, type LeadSnapshot } from "@/lib/ai/context";
+import { formatCurrency } from "@/lib/utils";
+
+export type RiskLevel = "Healthy" | "Needs Attention" | "High Risk";
+
+export type DealRiskLead = {
+  id: string;
+  name: string;
+  company: string;
+  status: LeadSnapshot["lead"]["status"];
+  value: number;
+  riskScore: number;
+  riskLevel: RiskLevel;
+  reasons: string[];
+  recommendedAction: string;
+};
+
+export type DealRiskSummary = {
+  highRisk: number;
+  needsAttention: number;
+  healthy: number;
+  total: number;
+};
+
+export type DealRiskRadar = {
+  leads: DealRiskLead[];
+  summary: DealRiskSummary;
+  generatedAt: string;
+};
+
+/**
+ * Deterministic 0-100 risk score for an OPEN lead. Every point traces back
+ * to a real, already-computed CRM signal (overdue follow-ups, contact
+ * recency, pipeline stage, notes, deal value) -- nothing here is invented
+ * or randomized, and the same inputs always produce the same score.
+ */
+export function computeRiskScore(item: LeadSnapshot): number {
+  let risk = 0;
+  const staleDays = item.daysSinceContact ?? item.daysSinceCreated;
+
+  // Overdue follow-ups are the strongest signal: up to 40 points.
+  risk += Math.min(40, item.overdueFollowUps * 20);
+
+  // Recency of contact/creation: up to 30 points.
+  if (staleDays >= 14) risk += 30;
+  else if (staleDays >= 7) risk += 20;
+  else if (staleDays >= 3) risk += 10;
+
+  // Stage stagnation.
+  if ((item.lead.status === "NEW" || item.lead.status === "CONTACTED") && item.daysSinceCreated >= 5) {
+    risk += 10;
+  }
+  if (item.lead.status === "PROPOSAL" && staleDays >= 5) {
+    risk += 10;
+  }
+
+  // Engagement depth.
+  if (item.notesCount === 0) risk += 10;
+
+  // No follow-up scheduled at all (neither overdue nor upcoming).
+  if (item.overdueFollowUps === 0 && item.upcomingFollowUps === 0) risk += 10;
+
+  // A stalling high-value deal is more urgent than an equally stalled small one.
+  if (item.lead.value >= HIGH_VALUE_THRESHOLD && risk > 0) risk += 5;
+
+  return Math.max(0, Math.min(100, risk));
+}
+
+export function riskLevelFromScore(score: number): RiskLevel {
+  if (score >= 60) return "High Risk";
+  if (score >= 30) return "Needs Attention";
+  return "Healthy";
+}
+
+/**
+ * Builds the evidence list shown to the user. Every line is generated from
+ * a real, already-computed field on the snapshot -- no fabricated dates,
+ * counts, or activity.
+ */
+export function buildRiskReasons(item: LeadSnapshot): string[] {
+  const reasons: string[] = [];
+  const staleDays = item.daysSinceContact ?? item.daysSinceCreated;
+
+  if (item.overdueFollowUps > 0) {
+    const dayLabel = item.oldestOverdueDays !== null ? `by ${item.oldestOverdueDays} day${item.oldestOverdueDays === 1 ? "" : "s"}` : "";
+    reasons.push(
+      item.overdueFollowUps === 1
+        ? `Follow-up is overdue ${dayLabel}`.trim()
+        : `${item.overdueFollowUps} follow-ups are overdue, the oldest ${dayLabel}`.trim(),
+    );
+  }
+
+  if (item.lead.lastContactedAt) {
+    if (staleDays >= 3) reasons.push(`Last activity was ${staleDays} day${staleDays === 1 ? "" : "s"} ago`);
+  } else if (item.lead.status !== "NEW" && item.daysSinceCreated >= 3) {
+    reasons.push(`No recorded contact since this lead was created ${item.daysSinceCreated} days ago`);
+  }
+
+  if ((item.lead.status === "NEW" || item.lead.status === "CONTACTED") && item.daysSinceCreated >= 5) {
+    reasons.push(`Lead remains in ${item.lead.status} stage after ${item.daysSinceCreated} days`);
+  }
+
+  if (item.lead.value >= HIGH_VALUE_THRESHOLD && (item.overdueFollowUps > 0 || staleDays >= 3)) {
+    reasons.push(`High-value ${formatCurrency(item.lead.value)} opportunity has no recent activity`);
+  }
+
+  if (item.notesCount === 0) {
+    reasons.push("No notes recorded for this lead");
+  }
+
+  if (item.overdueFollowUps === 0 && item.upcomingFollowUps === 0) {
+    reasons.push("No follow-up is currently scheduled");
+  }
+
+  return reasons.slice(0, 4);
+}
+
+function toDealRiskLead(item: LeadSnapshot): DealRiskLead {
+  const riskScore = computeRiskScore(item);
+  return {
+    id: item.lead.id,
+    name: item.lead.name,
+    company: item.lead.company,
+    status: item.lead.status,
+    value: item.lead.value,
+    riskScore,
+    riskLevel: riskLevelFromScore(riskScore),
+    reasons: buildRiskReasons(item),
+    recommendedAction: recommendedActionFor(item.lead, item.overdueFollowUps),
+  };
+}
+
+/**
+ * Builds the full Deal Risk Radar from a CRM snapshot. Only OPEN leads
+ * (never CONVERTED or LOST) are included, matching the feature's data
+ * safety requirement.
+ */
+export function buildDealRiskRadar(snapshot: CrmSnapshot, leadId?: string): DealRiskRadar {
+  const openLeads = snapshot.leads.filter(
+    (item) => item.lead.status !== "CONVERTED" && item.lead.status !== "LOST",
+  );
+  const scoped = leadId ? openLeads.filter((item) => item.lead.id === leadId) : openLeads;
+  const leads = scoped.map(toDealRiskLead).sort((a, b) => b.riskScore - a.riskScore);
+
+  const summary = leads.reduce(
+    (acc, item) => {
+      if (item.riskLevel === "High Risk") acc.highRisk += 1;
+      else if (item.riskLevel === "Needs Attention") acc.needsAttention += 1;
+      else acc.healthy += 1;
+      acc.total += 1;
+      return acc;
+    },
+    { highRisk: 0, needsAttention: 0, healthy: 0, total: 0 } as DealRiskSummary,
+  );
+
+  return { leads, summary, generatedAt: snapshot.generatedAt };
+}
